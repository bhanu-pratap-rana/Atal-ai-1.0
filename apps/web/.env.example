# ATAL AI Environment Configuration Template
# ============================================================
# CRITICAL: Copy this file to .env and fill in all values
# NEVER commit .env file (it contains secrets)
# NEVER commit .env.local (it contains local secrets)
# NEVER push service role keys to git
# ============================================================

# ============================================================
# 1. SUPABASE CONFIGURATION
# ============================================================
# Source: https://supabase.co/dashboard/project/[project-id]/settings/api

# Supabase Project URL (public)
# Format: https://[project-id].supabase.co
# Visibility: ✅ Safe to commit to .env.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (JWT - limited permissions)
# Format: eyJ... (long JWT token starting with ey)
# Visibility: ✅ Safe to commit to .env.example (limited scope)
# Used for: Public operations only (auth, public tables)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Full database access!)
# Format: eyJ... (long JWT token)
# ⚠️  DANGER: DO NOT commit this! Use Vercel environment instead
# Visibility: ❌ KEEP ONLY IN VERCEL SECRETS
# Used for: Server-side operations only (admin, migrations)
# Store in: Vercel Dashboard → Settings → Environment Variables → [Sensitive]
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# 2. DATABASE CONFIGURATION
# ============================================================

# Direct Postgres Connection URL (optional - for migrations)
# Format: postgresql://user:password@host:port/database
# Note: Usually managed by Supabase - only needed for CLI tools
# ⚠️  DO NOT commit this file with real credentials
DATABASE_URL=postgresql://postgres:password@localhost:5432/atal_ai

# ============================================================
# 3. AUTHENTICATION & OTP CONFIGURATION
# ============================================================

# Auth Redirect URL for OTP verification
# Format: http://localhost:3000 (dev) OR https://app.atal-ai.com (prod)
# Used by: Supabase auth emails
# For development:
NEXT_PUBLIC_AUTH_REDIRECT_TO=http://localhost:3000

# Email Provider Configuration (if using custom SMTP)
# Note: Supabase handles emails by default
# Only fill if using SendGrid / AWS SES / etc
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.your-sendgrid-key...

# Auth Debug Mode (development only)
# Set to 'true' to see detailed auth logs
NEXT_PUBLIC_AUTH_DEBUG=false

# ============================================================
# 4. RATE LIMITING CONFIGURATION
# ============================================================

# Redis Configuration (for distributed rate limiting in production)
# Format: redis://[user]:[password]@[host]:[port]
# Leave empty to use in-memory rate limiting (development only)
# Note: In-memory rate limiter is NOT suitable for multi-instance deployments

# Redis Connection String (optional - production recommended)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Rate Limiter Configuration
# OTP rate limit: max requests per time window
# Development: 10 requests per hour
# Production: 5 requests per hour
OTP_RATE_LIMIT_REQUESTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=60

# ============================================================
# 5. ERROR TRACKING & MONITORING
# ============================================================

# Sentry Error Tracking (optional but recommended)
# Source: https://sentry.io/ → Create project → Copy DSN
# Used for: Production error tracking and monitoring
# Visibility: ✅ Safe to commit (identifies your app only)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry Environment
# Values: development | staging | production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Sentry Sample Rate (% of errors sent)
# 0.0 = no errors sent (development)
# 1.0 = all errors sent (production)
NEXT_PUBLIC_SENTRY_SAMPLE_RATE=0.1

# Sentry Organization Slug (for source map uploads)
# Source: https://sentry.io/settings/organization/
# Required for source map uploads in CI/CD
SENTRY_ORG=your-org-slug

# Sentry Project Slug (for source map uploads)
# Source: https://sentry.io/settings/organization/projects/
SENTRY_PROJECT=atal-ai

# Sentry Auth Token (for source map uploads)
# Source: https://sentry.io/settings/auth-tokens/
# ⚠️  DANGER: DO NOT commit this! Use Vercel environment instead
# Visibility: ❌ KEEP ONLY IN VERCEL SECRETS
SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here

# ============================================================
# 6. FEATURE FLAGS & FEATURE TOGGLES
# ============================================================

# Analytics & Tracking
# Set to 'true' to enable analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Admin Dashboard Access
# Set to 'true' to enable admin panel
NEXT_PUBLIC_ENABLE_ADMIN_DASHBOARD=false

# Beta Features
# Set to 'true' to enable experimental features
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# AI Features (if using AI/ML)
NEXT_PUBLIC_ENABLE_AI_FEATURES=true

# ============================================================
# 13. AI SERVICE CONFIGURATION (ATAL AI)
# ============================================================

# Google Gemini API (Primary AI Provider - 25x cheaper than OpenAI)
# Source: https://aistudio.google.com/app/apikey
# Model: gemini-2.5-flash-preview-05-20
# ⚠️  DANGER: DO NOT commit this! Use Vercel environment instead
GEMINI_API_KEY=your-gemini-api-key

# Alternative: Google Generative AI API Key (same as GEMINI_API_KEY)
# Use if GEMINI_API_KEY is not set
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key

# Groq API (Fallback AI Provider - FREE tier available)
# Source: https://console.groq.com/keys
# Model: llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key

# HuggingFace API (legacy - now disabled)
# NOTE: HuggingFace Inference API discontinued TTS support in 2025
HUGGINGFACE_API_KEY=your-huggingface-api-key

# TTS Fallback URL (self-hosted on Render.com - optional)
# Deploy: https://render.com (FREE tier)
TTS_FALLBACK_URL=https://your-tts-app.onrender.com/tts

# ============================================================
# 15. GOOGLE CLOUD TTS (Recommended for natural voices)
# ============================================================
#
# High-quality TTS with excellent Hindi support!
# Free Tier: 1 million characters/month (WaveNet), 4 million (standard)
# Pricing: https://cloud.google.com/text-to-speech/pricing
#
# Setup Steps:
# 1. Go to https://console.cloud.google.com
# 2. Create a project or select existing one
# 3. Enable "Cloud Text-to-Speech API"
# 4. Create an API key or service account
#
# Option A: API Key (simpler, recommended for development)
# Source: https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_TTS_API_KEY=your-google-cloud-tts-api-key

# Option B: Service Account (more secure, recommended for production)
# Uses GOOGLE_APPLICATION_CREDENTIALS already defined above
# The service account needs "Cloud Text-to-Speech User" role
#
# Supported Voices:
# - English (en-IN): en-IN-Neural2-A (female), en-IN-Neural2-B (male)
# - Hindi (hi-IN): hi-IN-Neural2-A (female), hi-IN-Neural2-D (male)
# - Assamese: Falls back to Bengali (bn-IN) which is phonetically similar

# ============================================================
# 14. VERTEX AI (Imagen 3 / Veo)
# ============================================================
#
# Imagen 3 and other Vertex AI media models require OAuth2 authentication.
# API keys are NOT supported for Imagen 3 - you must use a GCP project
# with Vertex AI API enabled and either:
# - Service account JSON via GOOGLE_APPLICATION_CREDENTIALS
# - Application Default Credentials (gcloud auth application-default login)
#
# GCP project ID (required)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Region for Vertex AI (optional, defaults to us-central1 in code)
GOOGLE_CLOUD_REGION=us-central1

# Local path to service account JSON (for development only)
# Example (Windows): C:\Users\YourName\keys\vertex-service-account.json
# Example (macOS/Linux): /Users/yourname/keys/vertex-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ============================================================
# AI COST ESTIMATES (per 100 students/month)
# ============================================================
# Gemini 2.5 Flash: ~₹1,000 (2M tokens)
# AI4Bharat TTS: FREE (HuggingFace or self-hosted)
# Web Speech API: FREE (browser-native)
# Total: ~₹1,435/month = ₹172/year per student
# Budget compliance: 97% under original ₹5,000 budget

# ============================================================
# 7. DEPLOYMENT & ENVIRONMENT
# ============================================================

# Node Environment (automatically set by deployment platform)
# Values: development | production
# Development: Extended logs, relaxed security
# Production: Optimized, strict security
NODE_ENV=development

# Application Environment (custom setting)
# Values: development | staging | production
NEXT_PUBLIC_ENVIRONMENT=development

# Application URL (for absolute URLs in emails, etc)
# Development: http://localhost:3000
# Production: https://app.atal-ai.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API URL (if separate from app URL)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ============================================================
# 8. THIRD-PARTY INTEGRATIONS
# ============================================================

# Google OAuth (optional - for social login)
# Source: https://console.cloud.google.com
# Note: Client ID can be public, but CLIENT_SECRET must NEVER use NEXT_PUBLIC_ prefix
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id...
GOOGLE_OAUTH_CLIENT_SECRET=your-google-secret...

# GitHub OAuth (optional - for developer login)
GITHUB_OAUTH_CLIENT_ID=your-github-app-id...
GITHUB_OAUTH_CLIENT_SECRET=your-github-secret...

# ============================================================
# 9. SECURITY CONFIGURATION
# ============================================================

# CORS Configuration
# Comma-separated list of allowed origins
NEXT_PUBLIC_CORS_ORIGIN=http://localhost:3000

# API Rate Limiting (requests per minute)
NEXT_PUBLIC_API_RATE_LIMIT=100

# Session Timeout (minutes)
# How long before user is logged out
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30

# ============================================================
# 10. LOGGING & DEBUG
# ============================================================

# Log Level
# Values: debug | info | warn | error
NEXT_PUBLIC_LOG_LEVEL=info

# Debug Mode
# Set to 'true' to enable detailed console logs
DEBUG=false

# ============================================================
# 11. OPTIONAL: TESTING CONFIGURATION
# ============================================================

# Test Email (for automated tests)
TEST_EMAIL=test@example.com
TEST_PASSWORD=testPassword123!

# Test Phone (for SMS testing)
TEST_PHONE=+919876543210

# ============================================================
# 12. OPTIONAL: PERFORMANCE & OPTIMIZATION
# ============================================================

# Enable Service Worker (PWA - Progressive Web App)
NEXT_PUBLIC_ENABLE_PWA=true

# Cache Strategy
# Values: aggressive | moderate | conservative
NEXT_PUBLIC_CACHE_STRATEGY=moderate

# ============================================================
# ENVIRONMENT CHECKLIST
# ============================================================

# Before deploying to production:
# ✅ Copy this file to .env
# ✅ Fill in ALL required values (marked REQUIRED)
# ✅ Verify NO placeholder values remain (like "your-...")
# ✅ Verify SUPABASE_SERVICE_ROLE_KEY is only in Vercel (not in .env)
# ✅ Run: npm run build (should pass with 0 errors)
# ✅ Run: npm run test (all tests should pass)
# ✅ Review: .env.local and .env files should NEVER be committed
# ✅ Verify: All third-party API keys are correct
# ✅ Check: Feature flags are set appropriately for environment

# ============================================================
# ROTATE SECRETS MONTHLY
# ============================================================

# Schedule:
# - First Monday of each month: Rotate Supabase anon key
# - First Tuesday: Rotate service role key (in Vercel)
# - First Wednesday: Rotate Redis password (if using)
# - First Thursday: Rotate SendGrid API key (if using)

# Last rotated: [DATE]
# Next rotation: [DATE]

# ============================================================
# SUPPORT & TROUBLESHOOTING
# ============================================================

# If you encounter issues:
# 1. Double-check all required values are filled
# 2. Verify service keys are not accidentally committed
# 3. Check Supabase dashboard for rate limits
# 4. Review Sentry dashboard for errors
# 5. Check GitHub Actions logs for deployment errors

# Documentation:
# - Supabase: https://supabase.com/docs
# - Next.js: https://nextjs.org/docs
# - Environment Variables: https://nextjs.org/docs/basic-features/environment-variables
