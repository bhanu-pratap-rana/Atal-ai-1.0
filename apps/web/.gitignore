# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache
/playwright/screenshots
/tests/screenshots

# next.js
/.next/
/.next
.next/
.next
/out/
/.swc/
.swc/
.swc

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
test-output.log
*-test.log
test-results.json

# env files (can opt-in for committing if needed)
.env*
!.env.example

# auth files - contain session tokens
playwright/.auth/*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# PWA generated files (legacy next-pwa, no longer used)
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/worker-*.js
/public/worker-*.js.map
