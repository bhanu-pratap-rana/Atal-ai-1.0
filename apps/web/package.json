{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:database": "cross-env NODE_ENV=test jest --config jest.database.config.js",
    "test:database:watch": "cross-env NODE_ENV=test jest --config jest.database.config.js --watch",
    "test:database:coverage": "cross-env NODE_ENV=test jest --config jest.database.config.js --coverage",
    "test:database:rpc": "cross-env NODE_ENV=test jest --config jest.database.config.js __tests__/database/rpc",
    "test:database:rls": "cross-env NODE_ENV=test jest --config jest.database.config.js __tests__/database/rls",
    "test:database:load": "cross-env NODE_ENV=test jest --config jest.database.config.js __tests__/database/load",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:smoke": "playwright test smoke.spec.ts",
    "test:e2e:comprehensive": "playwright test comprehensive.spec.ts",
    "test:e2e:flows": "playwright test tests/flows/",
    "test:e2e:teacher": "playwright test tests/flows/teacher-flow.spec.ts --project=chromium-teacher",
    "test:e2e:student": "playwright test tests/flows/student-flow.spec.ts --project=chromium-student",
    "test:e2e:admin": "playwright test tests/flows/admin-flow.spec.ts --project=chromium-admin",
    "test:e2e:class": "playwright test tests/flows/class-management.spec.ts --project=chromium-teacher",
    "test:e2e:assessment": "playwright test tests/flows/assessment-flow.spec.ts --project=chromium-student",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:all": "playwright test",
    "test:e2e:quick": "playwright test smoke.spec.ts comprehensive.spec.ts --workers=4",
    "index:curriculum": "npx tsx scripts/index-curriculum.ts",
    "test:imagen": "npx tsx scripts/test-imagen.ts",
    "verify": "npm run build && npm run test:e2e:quick",
    "verify:full": "npm run build && npm run test:e2e:flows",
    "sonar": "cd ../.. && sonar-scanner",
    "sonar:local": "cd ../.. && sonar-scanner -Dsonar.host.url=http://localhost:9000"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.0",
    "@ai-sdk/google-vertex": "^4.0.21",
    "@ai-sdk/groq": "^1.2.0",
    "@ai-sdk/openai-compatible": "^2.0.13",
    "@ai-sdk/react": "^1.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.30.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.80.0",
    "@types/bcrypt": "^6.0.0",
    "@types/qrcode": "^1.5.6",
    "ai": "^4.3.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.14",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.24",
    "google-auth-library": "^10.5.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.553.0",
    "next": "^16.1.6",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.66.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.24.0",
    "zxcvbn": "^4.4.2"
  },
  "overrides": {
    "jsondiffpatch": ">=0.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@snaplet/copycat": "^6.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/zxcvbn": "^4.4.5",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.9",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "pg": "^8.13.0",
    "supawright": "^0.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
